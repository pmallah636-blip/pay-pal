# PayPal Sandbox only. Copy these entries into .env.local and replace values.
# The public Client ID is used by the PayPal browser SDK. Keep the Secret server-side.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_rotated_sandbox_secret
PAYPAL_WEBHOOK_ID=your_registered_sandbox_webhook_id

# Supabase Auth + database persistence.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: sample invoice checkout for local development only. Never enable in production.
PAYMIND_DEMO_MODE=true
