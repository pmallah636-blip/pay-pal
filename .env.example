# Copy to .env.local and fill in locally. Never commit .env.local.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_rotated_sandbox_secret
PAYPAL_WEBHOOK_ID=your_registered_sandbox_webhook_id

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Development only. Never set this in production.
PAYMIND_DEMO_MODE=true

# Server-side AI configuration for contract analysis, AI Scope Change Detector, AG Studio and AI Contract-to-Delivery Check.
# Select one provider and configure only its matching key. Keep all keys server-side.
# The same configured provider is used by Contract Analysis, Scope Change Detector and Delivery Check.
PAYMIND_AI_PROVIDER=gemini
PAYMIND_AI_MODEL=your_supported_model_id
GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key
